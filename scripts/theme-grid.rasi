/* ~/.config/hypr/scripts/theme-grid.rasi */
configuration {
    show-icons: true;
}

* {
    background:          #080a0f;
    background-alt:      #121620;
    text-color:          #f1f5f9;
    accent-color:        #6366f1;
}

window {
    width:               90%;
    height:              42%;
    location:            center;
    anchor:              center;
    border:              2px;
    border-radius:       20px;
    border-color:        @accent-color;
    background-color:    @background;
}

mainbox {
    children:            [ listview ];
    padding:             20px;
    background-color:    transparent;
}

listview {
    columns:             5;          /* Fixed 5 columns so all themes display at once */
    lines:               1;          /* Single horizontal row */
    spacing:             16px;
    cycle:               true;
    dynamic:             true;
    background-color:    transparent;
}

element {
    orientation:         vertical;
    padding:             14px;
    border-radius:       14px;
    border:              2px;
    border-color:        #1e293b;
    background-color:    @background-alt;
    text-color:          @text-color;
}

element selected {
    border-color:        @accent-color;
    background-color:    #1e2a4a;
}

element-icon {
    size:                180px;
    horizontal-align:    0.5;
    vertical-align:      0.5;
    background-color:    transparent;
    border-radius:       10px;
}

element-text {
    horizontal-align:    0.5;
    vertical-align:      0.5;
    margin:              10px 0px 0px 0px;
    background-color:    transparent;
    text-color:          inherit;
    font:                "JetBrainsMono Nerd Font Bold 11";
}
